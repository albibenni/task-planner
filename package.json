{
  "name": "task-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth": "tsx src/cli.ts auth",
    "run": "tsx src/index.ts run",
    "dry-run": "tsx src/index.ts run --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@biomejs/biome": "^2.5.6",
    "husky": "^9.1.7",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
